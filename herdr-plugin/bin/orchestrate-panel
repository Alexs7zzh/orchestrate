#!/bin/sh
# Orchestrate board and simple run controls for herdr.
set -u

MODE="${1:-panel}"

if ! command -v orchestrate >/dev/null 2>&1; then
  echo "orchestrate-panel: no \`orchestrate\` on PATH." >&2
  echo "Install it, then run: orchestrate setup" >&2
  exit 1
fi

pick_run() {
  if [ "$1" = all ]; then
    orchestrate runs 2>/dev/null
  else
    orchestrate runs "$1" 2>/dev/null
  fi | awk '
    length($1) == 23 &&
    substr($1, 1, 14) ~ /^[0-9]+$/ &&
    substr($1, 15, 1) == "-" &&
    substr($1, 16, 8) ~ /^[0-9a-f]+$/ { print $1; exit }
  '
}

case "$MODE" in
  panel)
    RUN_ID="$(pick_run --needs-attention)"
    [ -n "$RUN_ID" ] || RUN_ID="$(pick_run all)"
    if [ -z "$RUN_ID" ]; then
      echo "No orchestrate runs found."
      exit 0
    fi
    exec orchestrate board "$RUN_ID"
    ;;
  pause)
    RUN_ID="$(pick_run --active)"
    if [ -z "$RUN_ID" ]; then
      echo "orchestrate-panel: no active run to pause." >&2
      exit 1
    fi
    exec orchestrate pause "$RUN_ID"
    ;;
  resume)
    RUN_ID="$(pick_run --paused)"
    if [ -z "$RUN_ID" ]; then
      echo "orchestrate-panel: no paused run to resume." >&2
      exit 1
    fi
    exec orchestrate resume "$RUN_ID"
    ;;
  herdr-event)
    exec orchestrate herdr-event --json
    ;;
  *)
    echo "orchestrate-panel: unknown mode \"$MODE\" (expected: panel, pause, resume, herdr-event)." >&2
    exit 2
    ;;
esac
