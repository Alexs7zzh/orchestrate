#!/bin/sh
# Orchestrate board and simple run controls for herdr.
set -u

MODE="${1:-panel}"
ORCHESTRATE_EXECUTABLE= # ORCHESTRATE_SETUP_EXECUTABLE

if [ -z "$ORCHESTRATE_EXECUTABLE" ]; then
  ORCHESTRATE_EXECUTABLE="$(command -v orchestrate 2>/dev/null || true)"
fi

if [ -z "$ORCHESTRATE_EXECUTABLE" ] || [ ! -x "$ORCHESTRATE_EXECUTABLE" ]; then
  echo "orchestrate-panel: no \`orchestrate\` on PATH." >&2
  echo "Install it, then run: orchestrate setup" >&2
  exit 1
fi

pick_run() {
  if [ "$1" = all ]; then
    "$ORCHESTRATE_EXECUTABLE" runs 2>/dev/null
  else
    "$ORCHESTRATE_EXECUTABLE" runs "$1" 2>/dev/null
  fi | awk '
    length($1) == 23 &&
    substr($1, 1, 14) ~ /^[0-9]+$/ &&
    substr($1, 15, 1) == "-" &&
    substr($1, 16, 8) ~ /^[0-9a-f]+$/ { print $1; exit }
  '
}

case "$MODE" in
  panel)
    RUN_ID="$(pick_run --needs-attention)"
    [ -n "$RUN_ID" ] || RUN_ID="$(pick_run all)"
    if [ -z "$RUN_ID" ]; then
      echo "No orchestrate runs found."
      exit 0
    fi
    exec "$ORCHESTRATE_EXECUTABLE" board "$RUN_ID"
    ;;
  pause)
    RUN_ID="$(pick_run --active)"
    if [ -z "$RUN_ID" ]; then
      echo "orchestrate-panel: no active run to pause." >&2
      exit 1
    fi
    exec "$ORCHESTRATE_EXECUTABLE" pause "$RUN_ID"
    ;;
  resume)
    RUN_ID="$(pick_run --paused)"
    if [ -z "$RUN_ID" ]; then
      echo "orchestrate-panel: no paused run to resume." >&2
      exit 1
    fi
    exec "$ORCHESTRATE_EXECUTABLE" resume "$RUN_ID"
    ;;
  herdr-event)
    exec "$ORCHESTRATE_EXECUTABLE" herdr-event --json
    ;;
  startup-attention)
    # After a herdr server restart or handoff, panes may have vanished in bulk.
    RUN_ID="$(pick_run --needs-attention)"
    if [ -n "$RUN_ID" ]; then
      herdr notification show "Orchestrate" \
        --body "Run $RUN_ID needs attention after restart. Inspect with: orchestrate status $RUN_ID" \
        --sound request >/dev/null 2>&1 || true
    fi
    exit 0
    ;;
  *)
    echo "orchestrate-panel: unknown mode \"$MODE\" (expected: panel, pause, resume, herdr-event, startup-attention)." >&2
    exit 2
    ;;
esac
