{
  "version": 1,
  "name": "secret-redaction",
  "objective": "Verify public CLI redaction while binding secrets in the digest.",
  "cwd": "/tmp",
  "concurrency": 1,
  "heartbeat": {
    "intervalMinutes": null,
    "milestones": false,
    "callback": {
      "type": "webhook",
      "url": "https://example.test/orchestrate",
      "headers": { "Authorization": "webhook-secret-v1" },
      "timeoutSeconds": 15
    }
  },
  "limits": {
    "nodeWallTimeMinutes": null,
    "workflowWallTimeMinutes": null,
    "maxAgentStarts": null,
    "maxGoalRounds": null
  },
  "writeConflicts": "reject",
  "nodes": [
    {
      "id": "check",
      "type": "command",
      "title": "Check",
      "needs": [],
      "cwd": null,
      "workspace": {
        "mode": "shared",
        "path": null,
        "vcs": "none",
        "writes": [],
        "exclusiveResources": []
      },
      "inputs": [],
      "timeoutMinutes": null,
      "retry": { "maxAttempts": 1, "delaySeconds": 0 },
      "gate": "none",
      "argv": ["/usr/bin/true"],
      "mutates": false,
      "inheritEnv": [],
      "env": { "COMMAND_SECRET": "command-secret-v1" },
      "allowedExitCodes": [0]
    },
    {
      "id": "supervise",
      "type": "supervisor",
      "title": "Supervise",
      "needs": ["check"],
      "cwd": null,
      "workspace": {
        "mode": "shared",
        "path": null,
        "vcs": "none",
        "writes": [],
        "exclusiveResources": []
      },
      "inputs": [],
      "timeoutMinutes": null,
      "retry": { "maxAttempts": 1, "delaySeconds": 0 },
      "gate": "none",
      "provider": "codex",
      "model": "provider-default",
      "effort": null,
      "prompt": "Decide whether the redaction contract is complete.",
      "session": {
        "mode": "fresh",
        "from": null,
        "saveAs": null,
        "retain": false,
        "reuseOnRepeat": false
      },
      "permissions": {
        "sandbox": "read-only",
        "extraArgs": [],
        "inheritEnv": [],
        "env": { "AGENT_SECRET": "agent-secret-v1" }
      },
      "goal": "Confirm the contract.",
      "termination": {
        "success": "The contract is confirmed.",
        "convergence": "No further checks are needed.",
        "maxRounds": 1,
        "maxWallTimeMinutes": 1
      },
      "envelope": {
        "providers": ["codex"],
        "models": ["provider-default"],
        "nodeTypes": ["agent", "command"],
        "cwdRoots": ["/tmp"],
        "writeRoots": [],
        "workspaceModes": ["shared"],
        "vcs": ["none"],
        "gitWorktree": {
          "allowed": false,
          "branchPrefixes": [],
          "startPoints": [],
          "allowRemoveOnClean": false
        },
        "allowCommands": true,
        "commandArgvPrefixes": [["/usr/bin/true"]],
        "allowedCommandEnv": [{ "ADAPTIVE_COMMAND_SECRET": "adaptive-command-secret-v1" }],
        "codexSandboxes": ["read-only"],
        "claudePermissionModes": [],
        "allowedExtraArgs": [],
        "allowedInheritedEnv": [],
        "allowedProviderEnv": [{ "ADAPTIVE_AGENT_SECRET": "adaptive-agent-secret-v1" }],
        "resumableSessionAliases": [],
        "newSessionAliasPrefixes": [],
        "maxAddedNodesPerRound": 1
      }
    }
  ]
}
